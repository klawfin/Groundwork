# ---------------------------------------------------------------------------
# Groundwork by Klawfin - environment template.
#
# PLACEHOLDERS ONLY. No real values in this file, in the repo, or in any
# document.
#
# COPY THIS TO apps/web/.env - NOT to the repository root. Next.js loads
# environment files relative to its own project directory, so a .env at the
# monorepo root is silently ignored and the app starts with no configuration
# at all. It presents as "database unreachable" with nothing else to go on.
#
# Anything prefixed NEXT_PUBLIC_ IS IN THE BROWSER BUNDLE. Treat it as
# published. Nothing secret goes there, ever.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------

# Public by design - safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public by design. Its privileges are whatever RLS allows, which in Phase 1
# should be almost nothing. That is only true if RLS is correct - see
# supabase/migrations/20260919000300_rls.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-SIDE ONLY. BYPASSES RLS ENTIRELY. This is the single highest-value
# secret in the system. If it ever appears in a client bundle, in a log, or in
# a NEXT_PUBLIC_ variable, ROTATE IT IMMEDIATELY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic -------------------------------------------------------------

# Server-side only. Set a spend limit on the key in the Anthropic console as
# well as in application code: application-level caps do not protect against a
# bug in the application.
ANTHROPIC_API_KEY=your-api-key

# Model id. Complete as written - DO NOT append a date suffix.
# PRD OPEN-05: A/B a mid-tier against a frontier model on two or three real
# intakes before fixing a default. Every model listed in packages/llm/src/cost.ts
# is priced, so switching is an env change.
#   claude-opus-5     $5 / $25 per MTok
#   claude-sonnet-5   $2 / $10 per MTok
#   claude-haiku-4-5  $1 / $5  per MTok
ANTHROPIC_MODEL_ID=claude-opus-5

# --- OpenRouter (alternative provider) -------------------------------------

# Used when ANTHROPIC_API_KEY is absent. The provider is chosen at
# CONFIGURATION time, not as a runtime failover: a generation that failed on
# one provider and silently retried on another would bill twice and break the
# "maximum one retry, never a loop" rule (PRD 6.6).
# OPENROUTER_API_KEY=your-openrouter-key

# Check the id against https://openrouter.ai/models before relying on it.
OPENROUTER_MODEL_ID=anthropic/claude-sonnet-5

# PRE-FLIGHT COST GATE ONLY. The ledger records the exact cost OpenRouter
# reports for each call. These rates exist because OpenRouter fronts hundreds
# of models at prices that move - a checked-in pricing table would be stale
# within weeks and the cost ledger would quietly under-report.
OPENROUTER_INPUT_USD_PER_MTOK=2
OPENROUTER_OUTPUT_USD_PER_MTOK=10

# --- Authorisation ---------------------------------------------------------

# Comma-separated allowlist. Server-side only. The authorisation boundary for
# the whole application in Phase 1, alongside the database trigger in
# supabase/migrations/20260919000500_auth_allowlist.sql.
AUTH_ALLOWED_EMAILS=someone@example.com,someone-else@example.com

# Canonical application URL. Used for auth redirects and signed-URL construction.
APP_URL=http://localhost:3000

# --- Cost and versioning ---------------------------------------------------

# Hard per-report cost cap in rupees. Generation aborts above this.
REPORT_COST_CAP_INR=40

# USD to INR rate used for cost computation. Recorded on every llm_calls row so
# historical costs stay correct when the rate moves.
USD_INR_RATE=88

# --- Development -----------------------------------------------------------

# Run the app without calling the API. Use this for ALL UI work: it costs
# nothing and it exercises the fallback report path, which is otherwise hard to
# reach and is exactly what you will need on the morning something breaks.
DISABLE_LLM_GENERATION=false

# debug | info | warn | error. NEVER debug in production.
LOG_LEVEL=info

# --- Error tracking (optional) ---------------------------------------------

# CONFIGURE PII SCRUBBING BEFORE ENABLING. The default configuration captures
# request bodies, which here means client cap tables and financials.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# PHASE 2 ONLY - not before the gate opens (3 real paying clients delivered).
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# LEAD_NOTIFICATION_EMAIL=
# NEXT_PUBLIC_ANALYTICS_KEY=
# RATE_LIMIT_SECRET=

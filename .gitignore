# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secrets. A key committed to git - even in a deleted commit, even in a branch
# nobody merged - is COMPROMISED. Rotate it. Do not rewrite history and call
# it fixed (readme.md).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Database dumps contain real client financial data. They must never be
# committed, and when stored anywhere they must be encrypted (architecture 7.5).
*.dump
*.dump.age
*.sql.gz
backup-*

# Local Supabase
supabase/.branches/
supabase/.temp/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test output
coverage/
.vitest/

# Vercel
.vercel

docs/*

# ...but NOT the design record. decisions/ and TRACEABILITY.md are the only
# surviving rationale for why this system is shaped the way it is - the PRD and
# architecture documents were never committed. `docs/*` was silently swallowing
# every NEW decision file while the existing ones stayed tracked, so the record
# would have quietly stopped growing.
!docs/decisions/
!docs/decisions/**
!docs/AI_CODING_RULES.md
!docs/TRACEABILITY.md

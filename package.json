{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Groundwork by Klawfin - internal delivery tool for the Fundraise-Readiness Sprint.",
  "scripts": {
    "dev": "pnpm --filter @klawfin/web dev",
    "build": "pnpm --filter @klawfin/web build",
    "start": "pnpm --filter @klawfin/web start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "supabase db push",
    "db:seed": "docker exec -i supabase_db_klawfin psql -v ON_ERROR_STOP=1 -U postgres -d postgres < supabase/seed.sql",
    "demo": "node scripts/demo.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:palette": "node scripts/check-palette.mjs",
    "check:palette:built": "node scripts/check-palette.mjs --built",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:palette"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.25",
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1"
}

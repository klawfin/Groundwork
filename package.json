{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Groundwork by Klawfin - internal delivery tool for the Fundraise-Readiness Sprint.",
  "scripts": {
    "dev": "pnpm --filter @klawfin/web dev",
    "build": "pnpm --filter @klawfin/web build",
    "start": "pnpm --filter @klawfin/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db execute --file supabase/seed.sql"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.13.1"
}
